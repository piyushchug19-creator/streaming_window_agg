# Environment Configuration for Streaming Window Metrics Aggregator

# General
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Gateway
API_HOST=0.0.0.0
API_PORT=8000
PORT_GATEWAY=8001

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_PRIMARY_TOPIC=metrics-primary
KAFKA_DLQ_TOPIC=metrics-dlq
KAFKA_GROUP_ID=metrics-aggregator-group
KAFKA_DLQ_GROUP_ID=metrics-dlq-group
KAFKA_AUTO_OFFSET_RESET=earliest
PORT_KAFKA_HOST=29092

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
PORT_REDIS=6380
REDIS_PASSWORD=
REDIS_DB=0

# Token Bucket Rate Limiting (Load Shedding)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=100.0
RATE_LIMIT_REFILL_RATE=50.0

# 60-Second Tumbling Window Aggregation
WINDOW_SIZE_SECONDS=60
WINDOW_WATERMARK_DELAY_SECONDS=2
WINDOW_FLUSH_INTERVAL_SECONDS=1.0
WINDOW_STATE_TTL_SECONDS=7200

# Database Configuration (PostgreSQL / Neon DB)
# For local Docker Compose:
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/metrics_db
# For Neon DB cloud instance (uncomment & provide connection string):
# DATABASE_URL=postgresql://neondb_owner:npg_secret@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
PORT_POSTGRES=5433
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_MAX_RETRIES=5
DB_RETRY_BASE_DELAY=1.0
